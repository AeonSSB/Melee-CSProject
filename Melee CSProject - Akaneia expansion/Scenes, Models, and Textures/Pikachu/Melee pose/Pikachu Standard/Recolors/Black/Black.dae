                    </sampler2D>
                </newparam>
                <technique sid="standard">
                    <phong>
                        <emission>
                            <color sid="emission">0 0 0 1</color>
                        </emission>
                        <ambient>
                            <color sid="ambient">0.7019608 0.7019608 0.7019608 1</color>
                        </ambient>
                        <diffuse>
                            <color sid="diffuse">0.7019608 0.7019608 0.7019608 1</color>
                            <texture texture="Texture_0_RGB565-image_sampler" texcoord="CHANNEL0" />
                        </diffuse>
                        <specular>
                            <color sid="specular">1 1 1 1</color>
                        </specular>
                        <reflective>
                            <color sid="reflective">1 1 1 1</color>
                        </reflective>
                        <shininess>
                            <float sid="shininess">50</float>
                        </shininess>
                        <reflectivity>
                            <float sid="reflectivity">1</float>
                        </reflectivity>
                        <transparency>
