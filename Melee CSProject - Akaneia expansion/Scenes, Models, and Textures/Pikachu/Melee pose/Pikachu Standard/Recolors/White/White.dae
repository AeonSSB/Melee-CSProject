                <technique sid="standard">
                    <phong>
                        <emission>
                            <color sid="emission">0 0 0 1</color>
                        </emission>
                        <ambient>
                            <color sid="ambient">0.49803922 0.49803922 0.49803922 1</color>
                        </ambient>
                        <diffuse>
